############
# RPMS - Environment Variables
############

SESSION_SECRET=your-super-secret-32-char-key
DATABASE_URL=mysql://rpms:change-me@db:3306/rpms
NEXTAUTH_URL=https://rpms.example.com
PUBLIC_URL=https://rpms.example.com

# OAuth providers
DISCORD_APPLICATION_ID=
DISCORD_SECRET=
DISCORD_REDIRECT_URI=https://rpms.example.com/api/auth/discord/callback
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=https://rpms.example.com/api/auth/roblox/callback

# Discord Webhook integration
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_USERNAME=RPMS

############
# Database - used by Docker Compose
############

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me
MYSQL_USER=rpms
MYSQL_DATABASE=rpms
MYSQL_PORT=3306
